# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign Admin Dashboard session cookies.
# Change this to a long random string in production.
SESSION_SECRET="change-this-to-a-random-secret-key"

# Optional: Pre-configure Admin credentials via environment variables.
# If left unset, you can create your Admin account directly on /admin on first visit.
# ADMIN_EMAIL="admin@chunariya.com"
# ADMIN_PASSWORD=""

# Production / Netlify Frontend Configuration:
# Set VITE_API_BASE_URL in Netlify build environment variables to point to your hosted Express backend (e.g. https://api.chunariya.pk).
# Leave empty when serving frontend and backend from the same origin.
VITE_API_BASE_URL=""

# Backend CORS Configuration:
# Comma-separated list of frontend origins allowed to call this backend (e.g. https://chunariyaa.netlify.app).
ALLOWED_ORIGINS="https://chunariyaa.netlify.app"

