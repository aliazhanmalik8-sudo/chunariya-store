# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign Admin Dashboard session cookies.
# Change this to a long random string in production.
SESSION_SECRET="change-this-to-a-random-secret-key"

# Optional: Pre-configure Admin credentials via environment variables.
# If left unset, you can create your Admin account directly on /admin on first visit.
# ADMIN_EMAIL="admin@chunariya.com"
# ADMIN_PASSWORD=""
